# 环境变量配置文件
# 复制此文件为 .env 并根据实际环境修改
# 注意：.env 已被 .gitignore 排除，不会提交到版本库

# 会话加密密钥：生产环境请替换为足够长的随机字符串
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Flask 调试模式：仅开发调试时设为 1，生产环境保持为 0
FLASK_DEBUG=0

# Secure Cookie：在 HTTPS 环境下应设置为 1
# 本地 HTTP 环境请保持为 0，否则 Cookie 无法正常发送
SESSION_COOKIE_SECURE=0
